{
  "name": "raqzpl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/i18n.ts",
    "react-icons/**"
  ],
  "scripts": {
"dev": "vite & npm run watch:blog",
    "prebuild": "npm run blog:index && npm run blog:rss",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "blog:index": "tsx scripts/generate-blog-index.ts",
    "blog:rss": "tsx scripts/generate-rss.ts",
    "watch:blog": "nodemon --watch \"content/**/*\" -e mdx --exec \"npm run blog:index && npm run blog:rss\""
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.5",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "feed": "^5.1.0",
    "globals": "^16.5.0",
    "gray-matter": "^4.0.3",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-sitemap": "^0.8.2"
  }
}
